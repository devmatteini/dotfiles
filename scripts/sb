#!/usr/bin/env python3

import os
import sys
from pathlib import Path

from sb_lib import run


def main() -> int:
    try:
        workdir = Path.cwd().resolve(strict=True)
        run(sys.argv[1:], os.environ, workdir)
    except (OSError, RuntimeError, ValueError) as error:
        print(f"sb: error: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
