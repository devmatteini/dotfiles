{
  "$schema": "../nono-profile.schema.json",
  "extends": [
    "nolabs-ai/claude",
    "agent-common"
  ],
  "meta": {
    "name": "claude",
    "version": "1.0.0",
    "description": "Local Claude Code sandbox profile",
    "author": "devmatteini"
  },
  "security": {
    "capability_elevation": false
  },
  "filesystem": {
    "read_file": [
      "$HOME/dotfiles/configs/claude/settings-nono.json"
    ]
  },
  "environment": {
    "set_vars": {
      // Keep Claude runtime files in the existing cache; tool TMPDIR comes from sb.
      "CLAUDE_CODE_TMPDIR": "$HOME/.cache/claude"
    }
  },
  "session_hooks": {
    "before": {
      "script": "$HOME/dotfiles/configs/nono/hooks/claude-before.sh",
      "timeout_secs": 40
    }
  }
}
