{
  "$schema": "../nono-profile.schema.json",
  "extends": [
    "nolabs-ai/opencode",
    "agent-common"
  ],
  "meta": {
    "name": "opencode",
    "version": "2.0.0",
    "description": "Local OpenCode v2 sandbox profile",
    "author": "devmatteini"
  },
  "security": {
    "capability_elevation": false
  },
  "network": {
    "allow_domain": [
      "chatgpt.com",
      "models.opencode.ai",
      "auth.openai.com"
    ]
  },
  "session_hooks": {
    "before": {
      "script": "$HOME/dotfiles/configs/nono/hooks/opencode-before.sh",
      "timeout_secs": 40
    }
  }
}
