{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "includeGitInstructions": false,
  "permissions": {
    "defaultMode": "auto",
    "deny": [
      "Read(//**/.env)",
      "Edit(//**/.env)",
      "Read(//**/.env.*)",
      "Edit(//**/.env.*)",
      "Read(//**/.envrc*)",
      "Edit(//**/.envrc*)",
      "Read(//**/*.pem)",
      "Edit(//**/*.pem)",
      "Read(//**/*.key)",
      "Edit(//**/*.key)",
      "Read(//**/.ssh/**)",
      "Edit(//**/.ssh/**)",
      "Read(//**/.aws/**)",
      "Edit(//**/.aws/**)",
      "Read(//**/.gnupg/**)",
      "Edit(//**/.gnupg/**)",
      "Edit(//**/.npmrc)",
      "Read(~/.zsh.local)",
      "Edit(~/.zsh.local)",
      "Read(~/.bash.local)",
      "Edit(~/.bash.local)",
      "CronCreate",
      "CronDelete",
      "CronList",
      "DesignSync",
      "NotebookEdit",
      "Artifact",
      "PushNotification"
    ]
  },
  "model": "opus",
  "disableClaudeAiConnectors": true,
  "disableRemoteControl": true,
  "disableWorkflows": true,
  "disableArtifact": true,
  "statusLine": {
    "type": "command",
    "command": "$HOME/.claude/statusline.sh"
  },
  "enabledPlugins": {},
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": false,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "allowWrite": [
        "~/.local/share/pnpm",
        "~/.cache/pnpm",
        "~/.local/state/pnpm"
      ]
    },
    "network": {
      "tlsTerminate": {},
      "allowedDomains": [
        "registry.npmjs.org",
        "npm.pkg.github.com",
        "pkg-npm.githubusercontent.com"
      ]
    },
    "credentials": {
      "envVars": [
        {
          "name": "GITHUB_NPM_TOKEN",
          "mode": "mask",
          "injectHosts": [
            "npm.pkg.github.com"
          ]
        }
      ]
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "xhigh",
  "tui": "fullscreen",
  "autoCompactEnabled": false,
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    }
  }
}
