#!/usr/bin/env python3

import os
import socket
import subprocess
from pathlib import Path


def must_fail(operation) -> None:
    try:
        operation()
    except OSError:
        return
    raise AssertionError("masked operation succeeded")


cwd = Path.cwd()
if marker := os.environ.get("SB_TEST_MARKER"):
    Path(marker).write_text("executed")

scenario = os.environ["SB_TEST_SCENARIO"]
if scenario == "cwd":
    for relative in (".env", ".envrc", "nested/.env.local"):
        path = cwd / relative
        assert path.read_text() == ""
        must_fail(lambda path=path: path.write_text("changed"))
        must_fail(path.unlink)
        must_fail(lambda path=path: path.rename(path.with_name("renamed")))
    (cwd / "visible").write_text("changed")
    (cwd / "config.env").write_text("changed")
    (cwd / ".env.generated").write_text("generated")
elif scenario == "grants":
    read_dir = Path(os.environ["SB_TEST_READ_DIR"])
    write_dir = Path(os.environ["SB_TEST_WRITE_DIR"])
    granted_file = Path(os.environ["SB_TEST_GRANTED_FILE"])
    assert (read_dir / "visible").read_text() == "visible"
    assert (read_dir / ".env.read").read_text() == ""
    (write_dir / "created").write_text("created")
    must_fail(lambda: (write_dir / ".env.write").write_text("changed"))
    assert granted_file.read_text() == ""
elif scenario == "tmpdir":
    harness = Path(__file__).name
    expected_tmpdir = Path(f"/tmp/sb-{harness}-{os.getuid()}")
    assert os.environ["TMPDIR"] == str(expected_tmpdir), os.environ["TMPDIR"]
    assert os.environ["TMPPREFIX"] == str(expected_tmpdir / "zsh")
    if harness == "opencode":
        assert os.environ["BUN_TMPDIR"] == str(expected_tmpdir)
    else:
        assert os.environ["CLAUDE_CODE_TMPDIR"] == str(Path.home() / ".cache/claude")
    temporary = expected_tmpdir / f"sb-test-{os.getpid()}"
    try:
        temporary.write_text("temporary")
        assert temporary.read_text() == "temporary"
    finally:
        temporary.unlink(missing_ok=True)
    completed = subprocess.run(
        [
            "nono",
            "why",
            "--self",
            "--path",
            os.environ["TMPDIR"],
            "--op",
            "readwrite",
        ],
        capture_output=True,
        text=True,
        check=False,
    )
    assert completed.stdout.startswith("ALLOWED"), (
        completed.stdout + completed.stderr
    )
    for shell in ("bash", "zsh"):
        completed = subprocess.run(
            [shell, "-c", "cat - <<'EOL'\nhere document\nEOL"],
            capture_output=True,
            text=True,
            check=False,
        )
        assert completed.returncode == 0, completed.stdout + completed.stderr
        assert completed.stdout == "here document\n"
elif scenario == "java-tmpdir":
    completed = subprocess.run(
        ["java", "SbJavaTemp.java"],
        capture_output=True,
        text=True,
        check=False,
        timeout=20,
    )
    assert completed.returncode == 0, completed.stdout + completed.stderr
elif scenario == "localhost":
    with socket.create_connection(
        ("127.0.0.1", int(os.environ["SB_TEST_HOST_PORT"])), timeout=10
    ) as host, socket.socket() as listener:
        listener.bind(("0.0.0.0", 0))
        listener.listen()
        listener.settimeout(10)
        host.sendall(f"{listener.getsockname()[1]}\n".encode())
        connection, _ = listener.accept()
        with connection:
            connection.settimeout(10)
            assert connection.recv(64) == b"host-to-sandbox"
            connection.sendall(b"sandbox-to-host")
elif scenario == "xauthority":
    assert Path(os.environ["XAUTHORITY"]).read_text() == "cookie"
elif scenario == "clipboard":
    def xclip(*arguments: str) -> subprocess.CompletedProcess[bytes]:
        return subprocess.run(
            ["xclip", "-selection", "clipboard", *arguments],
            capture_output=True,
            check=False,
        )

    targets = xclip("-t", "TARGETS", "-o")
    assert targets.stdout == b"image/png\nimage/bmp\n", targets
    image = xclip("-t", "image/png", "-o")
    assert image.stdout == b"fake-image", image
    for denied in (("-t", "text/plain", "-o"), ("-o",)):
        completed = xclip(*denied)
        assert (completed.returncode, completed.stdout) == (1, b""), completed
    log = Path.home() / ".local/state/sb/clipboard.log"
    must_fail(log.read_text)
    must_fail(lambda: log.open("a").close())
    (cwd / "clipboard-socket").write_text(os.environ["SB_CLIPBOARD_SOCKET"])
else:
    for docker_socket in ("/run/docker.sock", "/var/run/docker.sock"):
        client = socket.socket(socket.AF_UNIX)
        must_fail(lambda path=docker_socket: client.connect(path))
        client.close()

(cwd / "result").write_text("ok")
